{% for client in clients %}
    <div class="client-row">
        <span class="c-name">{{ client.name }}</span>

        <twig:ux:disclose :context="client" render="ux_disclose/_clients.html.twig" block="client_cleared" class="c-protected">
            {% block button %}
                <button
                    type="button"
                    class="c-eye"
                    data-disclose-target="button"
                    data-action="disclose#reveal"
                    aria-label="Reveal the whole row"
                    title="Reveal the whole row"
                >
                    {{ ux_icon('bi:eye-slash', { class: 'c-eye-icon', 'aria-hidden': 'true' }) }}
                </button>
            {% endblock %}

            {% block content %}
                <span class="c-masked" data-disclose-target="value">••••••</span>
                <button
                    type="button"
                    class="c-eye"
                    data-disclose-target="hideButton"
                    data-action="disclose#hide"
                    aria-label="Hide this row"
                    title="Hide this row"
                    hidden
                >
                    {{ ux_icon('bi:eye', { class: 'c-eye-icon', 'aria-hidden': 'true' }) }}
                </button>
            {% endblock %}
        </twig:ux:disclose>
    </div>
{% else %}
    <p class="text-muted">No clients yet. Run <code>php bin/console app:seed-clients</code>.</p>
{% endfor %}

{# Revealed server-side on click, rendered by the disclose endpoint with the
   "subject" and "context" variables. Dormant when this template is included. #}
{% block client_cleared %}
    {% if subject is defined %}
        <span class="c-value">{{ subject.email }}</span>
        <span class="c-sep" aria-hidden="true">·</span>
        <span class="c-value">{{ subject.phone }}</span>
    {% endif %}
{% endblock %}
